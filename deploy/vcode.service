[Unit]
Description=Vcode cloud coding runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vcode
WorkingDirectory=/opt/vcode
Environment=VCODE_HOME=/etc/vcode
ExecStart=/opt/vcode/bin/vcode-start.sh
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/vcode /etc/vcode
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
