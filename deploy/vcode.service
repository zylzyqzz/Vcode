[Unit]
Description=Vcode cloud coding runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Single-user self-hosted admin mode. The authenticated Vcode runtime is
# intentionally allowed to operate the whole server, matching the owner's
# direct SSH capability. The HTTP service is still bound to localhost and
# exposed only through the authenticated reverse proxy.
User=root
WorkingDirectory=/opt/vcode
Environment=VCODE_HOME=/etc/vcode
ExecStart=/opt/vcode/bin/vcode-start.sh
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
